# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- Databases ---
*.db
*.sqlite
*.sqlite3
output/attendance.db

# --- Runtime output (keep folder, ignore generated files) ---
output/processed/*
!output/processed/.gitkeep
output/investigate_uploads/

# --- Data uploads (keep folder, ignore contents) ---
data/signing_sheets/*
!data/signing_sheets/.gitkeep
data/signatures/*
!data/signatures/.gitkeep

# --- Tooling caches ---
.claude/
.playwright/
node_modules/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Reports (submitted separately per spec) ---
report/
